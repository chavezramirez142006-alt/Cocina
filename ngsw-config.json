{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "menu-dinamico-api",
      "urls": [
        "/api/menu",
        "/api/categorias",
        "/api/productos/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "12h",
        "timeout": "3s",
        "strategy": "freshness"
      }
    },
    {
      "name": "pedidos-historial-api",
      "urls": [
        "/api/pedidos/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "3d",
        "strategy": "performance"
      }
    }
  ]
}
